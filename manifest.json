{
  "manifest_version": 3,
  "name": "일본어 띄어쓰기",
  "version": "2.2.4",
  "description": "Sudachi 文節 분석으로 일본어 웹페이지에 공백을 추가하고 원문으로 복원합니다.",
  "permissions": ["activeTab", "scripting", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "일본어 띄어쓰기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
